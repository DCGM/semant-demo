REPO=https://github.com/DCGM/semant-demo.git
BRANCH=main
# Full commit SHA to build; CI sets it. Empty builds the tip of BRANCH.
COMMIT=

BACKEND_URL=https://test-main.demo.semant.cz

TEST_SUBDOMAIN=test-main.demo.semant.cz
TEST_ROUTER_NAME=semant-demo-test-main

WEAVIATE_HOST=weaviate
WEAVIATE_REST_PORT=8080
WEAVIATE_GRPC_PORT=50051

EMBEDDING_SERVICE_HOST=embedding-service
EMBEDDING_SERVICE_PORT=8001
# Search and RAG query the Qwen vector through the qwen-embedder service (#385).
SEARCH_VECTORS_CONFIG=/app/semant_demo/configs/search_vectors_qwen.yaml
# Contextual annotation vectors (#328) with the same Qwen embedder; used only after
# `annotation_enrichment add-schema` (docs/DATA_MAINTENANCE.md).
ANNOTATION_VECTOR_CONFIG=/app/semant_demo/configs/annotation_vector_qwen.yaml

SQL_DB_PATH=/mnt/ssd2/semant_demo_app_test_data/test-main

OLLAMA_URLS=http://localhost:11434
OPENAI_API_KEY=
OPENAI_API_URL=https://openrouter.ai/api/v1
GOOGLE_API_KEY=

LANGCHAIN_API_KEY=

FEEDBACK_WEBHOOK_URL=
FEEDBACK_LOG_PATH=/app/feedback/feedback.log.jsonl

JWT_SECRET=

ALLOWED_ORIGIN=https://test-main.demo.semant.cz
PORT=8000
STATIC_PATH=./static
LOG_LEVEL=INFO

TOPICER_CONFIG_NAME=llm-openrouter
# Chunks per tag of optimized AI suggestions (sent to Topicer as max_chunks; #408)
TOPICER_MAX_CHUNKS_PER_TAG=40

OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://lgtm:4318
OTEL_EXPORTER_OTLP_LOGS_PATH=/v1/logs
OTEL_EXPORTER_OTLP_TRACES_PATH=/v1/traces
OTEL_EXPORTER_OTLP_METRICS_PATH=/v1/metrics
OTEL_METRIC_EXPORT_INTERVAL_MS=10000
OTEL_SERVICE_NAME=semant-demo-app
DEPLOYMENT_ENVIRONMENT=test-main
